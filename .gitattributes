* text=auto
*.HC text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.pdf binary
*.indd binary
*.idml binary
*.ISO binary
*.gz binary
*.ttf binary
*.png binary
# Preserve upstream license bytes, including original whitespace/CRLF.
licenses/* -text whitespace=-blank-at-eol,-blank-at-eof
